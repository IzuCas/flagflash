# FlagFlash API Configuration
# Copy this file to .env and adjust values for your environment

# =============================================================================
# Application Settings
# =============================================================================
APP_ENV=development

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_PORT=9001
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
# When running with docker-compose, point DB_HOST to the postgres service
DB_HOST=postgres
DB_PORT=5432
DB_USER=flagflash
DB_PASSWORD=flagflash_secret
DB_NAME=flagflash
DB_SSL_MODE=disable

# Docker Postgres compatibility (used by official Postgres image)
POSTGRES_USER=flagflash
POSTGRES_PASSWORD=flagflash_secret
POSTGRES_DB=flagflash

# Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# =============================================================================
# Redis Configuration
# =============================================================================
# When running with docker-compose, point REDIS_HOST to the redis service
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=24h

# =============================================================================
# SMTP Email Configuration (for invite emails)
# =============================================================================
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USERNAME=test@seudominio.com
SMTP_PASSWORD=change123
SMTP_FROM=test@seudominio.com

# =============================================================================
# Application URL (used in invite email links)
# =============================================================================
APP_URL=http://localhost:9002


VITE_API_URL=http://localhost:9001
VITE_WS_URL=ws://localhost:9001

